ll := import("@platforma-sdk/workflow-tengo:ll")
self := import("@platforma-sdk/workflow-tengo:tpl.light")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
slices := import("@platforma-sdk/workflow-tengo:slices")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
text := import("text")

self.defineOutputs("tsv", "stats", "recordStats")

self.body(func(inputs) {
	inputFiles := inputs[pConstants.VALUE_FIELD_NAME]
	columnsInfo := inputs.columnsInfo
	chains := inputs.chains
	config := inputs.config
	xsvType := "tsv"
	if !is_undefined(config) && !is_undefined(config.xsvType) { xsvType = config.xsvType }

	wf := pt.workflow().mem("8GiB").cpu(4)

	dataFrames := []
	inputMap := inputFiles.inputs()
	for key in maps.getKeys(inputMap) {
		file := inputMap[key]
		dataFrames = append(dataFrames, wf.frame(file, {
			xsvType: xsvType,
			id: "table_" + key,
			inferSchema: false
		}))
	}

	if len(dataFrames) == 0 {
		ll.panic("no input files found")
	}

	df := pt.concat(dataFrames)

	// Rename original columns to their target IDs for downstream processing.
	renameExpressions := []
	for canonical in maps.getKeys(columnsInfo.columnMapping) {
		original := columnsInfo.columnMapping[canonical]
		renameExpressions = append(renameExpressions, pt.col(original).alias(canonical))
	}
	df = df.withColumns(renameExpressions...)

	// QIAseq writes the constant region (TRAC), CLC the locus (TRA); either way the first three letters
	df = df.withColumns(pt.col("chain").fillNull("").strToUpper().strSlice(0, 3).alias("chain"))

	// Genes: the first of several calls, allele split off, and the locus added when only the
	// segment is named (V5-1, V-14N-3*01) as QIAseq does for mouse. A slash is kept: TRAV29/DV5 is one gene.
	m := columnsInfo.columnMapping
	geneExprs := []
	for g in ["v", "d", "j", "c"] {
		if m[g + "-gene"] == undefined { continue }
		call := pt.col(g + "-gene").fillNull("").strReplace(",.*$", "", { replaceAll: true }).strToUpper()
		segment := call.strSlice(0, 1).eq(text.to_upper(g))
		dashed := call.strSlice(1, 1).eq("-")
		bare := pt.when(dashed).then(pt.concatStr([call.strSlice(0, 1), call.strSlice(2)], { delimiter: "" })).otherwise(call)
		allele := pt.when(segment.and(call.neq(""))).then(pt.concatStr([pt.col("chain"), bare], { delimiter: "" })).otherwise(call)
		geneExprs = append(geneExprs, allele.strReplace("\\*.*$", "", { replaceAll: true }).alias(g + "-gene"))
		if m[g + "-allele"] != undefined { geneExprs = append(geneExprs, allele.alias(g + "-allele")) }
	}
	df = df.withColumns(geneExprs...)

	df = df.withColumns(pt.col("umi-count").strReplace(",", "", { replaceAll: true }).cast("Float64").fillNull(0).cast("Int64").alias("umi-count"))

	keepsV := pt.col("v-gene").neq("")
	keepsJ := pt.col("j-gene").neq("")
	aa := pt.col("cdr3-aa").fillNull("")
	keepsCdr3 := pt.col("cdr3-nt").fillNull("").neq("")
	keepsProductive := aa.neq("").and(aa.strContains("*", {literal: true}).not()).and(aa.strContains("_", {literal: true}).not())
	df.select(
		pt.col("v-gene").count().alias("record-count"),
		keepsV.not().cast("Int64").sum().alias("records-no-v"),
		keepsV.and(keepsJ.not()).cast("Int64").sum().alias("records-no-j"),
		keepsV.and(keepsJ).and(keepsCdr3.not()).cast("Int64").sum().alias("records-no-cdr3"),
		keepsV.and(keepsJ).and(keepsCdr3).and(keepsProductive.not()).cast("Int64").sum().alias("records-not-productive")
	).saveContent("records.tsv")
	df = df.filter(keepsV.and(keepsJ).and(keepsCdr3).and(keepsProductive)).withColumns(pt.lit("true").alias("is-productive"))

	chainToLoci := {
		"IGHeavy": ["IGH"],
		"IGLight": ["IGK", "IGL"],
		"TCRAlpha": ["TRA"],
		"TCRBeta": ["TRB"],
		"TCRGamma": ["TRG"],
		"TCRDelta": ["TRD"]
	}

	keyComponents := slices.map(columnsInfo.clonotypeKeyColumns, func(id) { return pt.col(id).fillNull("NA") })
	
	clonotypeKeyExpr := pt.
						concatStr(keyComponents, {delimiter: "|"}).
						hash("sha256", "base64_alphanumeric", 120).
						alias("clonotypeKey")

	for chain in chains {
		inChain := undefined
		for locus in chainToLoci[chain] {
			has := pt.col("chain").eq(locus)
			inChain = is_undefined(inChain) ? has : inChain.or(has)
		}
		chainDf := df.filter(inChain)

		// For Qiagen, CDR3 nucleotide and amino acid sequences are already provided
		// Add length columns
		chainDf = chainDf.withColumns(
			pt.col("cdr3-aa").strLenChars().alias("cdr3-aa-length")
		)
		chainDf = chainDf.withColumns(
			pt.col("cdr3-nt").strLenChars().alias("cdr3-nt-length")
		)
		
		chainDf = chainDf.withColumns(clonotypeKeyExpr)

		// Aggregate by clonotype key
		aggregations := []
		aggregations = append(aggregations, pt.col("umi-count").sum().alias("umi-count"))
		
		for col in columnsInfo.propertyColumns {
			aggregations = append(aggregations, pt.col(col.column).maxBy("umi-count").alias(col.column))
		}
		chainDf = chainDf.groupBy("clonotypeKey").agg(aggregations...)

		// Calculate UMI fraction
		chainDf = chainDf.withColumns(pt.col("umi-count").truediv(pt.col("umi-count").sum()).fillNaN(0).alias("umi-fraction"))

		// Keep only property and abundance columns
		keepColumns := ["clonotypeKey"]
		for col in columnsInfo.propertyColumns {
			keepColumns = append(keepColumns, col.column)
		}
		for col in columnsInfo.abundanceColumns {
			keepColumns = append(keepColumns, col.column)
		}
		chainDf = chainDf.select(keepColumns...)
		
		chainDf.save(chain + ".tsv")

		statsExprs := [
			pt.col("clonotypeKey").count().alias("clonotype-count"),
			pt.col("umi-count").sum().alias("umi-count")
		]
		stats := chainDf.select(statsExprs...)

		stats.saveContent("stats-" + chain + ".tsv")
	}

	wf = wf.run()

	tsv := {}
	stats := {}
	for chain in chains {
		tsv[chain] = wf.getFile(chain + ".tsv")
		stats[chain] = wf.getFileContent("stats-" + chain + ".tsv")
	}

	return {
		tsv: tsv,
		stats: stats,
		recordStats: wf.getFileContent("records.tsv")
	}
})
