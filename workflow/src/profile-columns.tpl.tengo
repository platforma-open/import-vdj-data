// Profile every column of the scientist's file: value type, and whether it holds amino-acid
// variable domains.
//
// Runs at prerun, over the WHOLE file. The mapping panel needs both answers before anything is
// imported — which columns to offer as chain slots, and what type a record property will be
// emitted as — and both are wrong if taken from a sample. A column that is numeric for twenty
// rows and holds "N/A" further down must come out String, and only a full pass can say so.
//
// The result is one JSON blob rather than three outputs because the model has to parse it
// anyway: an exec's file content is a future value here, not something tengo can decode while
// building the plan.

self := import("@platforma-sdk/workflow-tengo:tpl.light")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
ll := import("@platforma-sdk/workflow-tengo:ll")
json := import("json")

profileSw := assets.importSoftware("@platforma-open/milaboratories.import-vdj.column-profile:main")

self.defineOutputs("profile")

self.body(func(inputs) {
	ll.assert(inputs.file != undefined, "profile-columns: file is required")
	// A name — "tab" or "comma" — not the character. See prerun: a real tab does not survive
	// the `sh -c` round-trip the k8s runner puts argv through. main.py maps the name back.
	ll.assert(inputs.separator != undefined, "profile-columns: separator is required")

	cmd := exec.builder().
		software(profileSw).
		cpu(1).
		mem("2GiB").
		addFile("input.txt", inputs.file).
		arg("--input").arg("input.txt").
		arg("--separator").arg(inputs.separator).
		arg("--output").arg("profile.json")
	// The shortest value that counts as a sequence when the profile decides which columns hold
	// amino-acid or nucleotide sequences. The default (50) fits antibody and TCR variable domains;
	// the peptide import passes a lower one, since peptides are much shorter.
	if inputs.minSequenceLength != undefined {
		cmd = cmd.arg("--min-sequence-length").arg(string(inputs.minSequenceLength))
	}
	// Every sample file's header row, for the columns all files have: `headerIds[i]` is the i-th
	// file's sample id (repeated when a sample has several files), `header_<i>` the file. Each file
	// is attached to the job; a manifest says which sample each belongs to, so the command line
	// stays short however many files there are. Only their first line is read.
	if inputs.headerIds != undefined {
		manifest := []
		for i, id in inputs.headerIds {
			name := "header-" + string(i) + ".txt"
			cmd = cmd.addFile(name, inputs["header_" + string(i)])
			manifest = append(manifest, { sample: id, file: name })
		}
		cmd = cmd.
			writeFile("headers.json", json.encode({ headers: manifest })).
			arg("--headers-manifest").arg("headers.json")
	}
	cmd = cmd.
		saveFileContent("profile.json").
		printErrStreamToStdout().
		run()

	return {
		profile: cmd.getFileContent("profile.json")
	}
})
