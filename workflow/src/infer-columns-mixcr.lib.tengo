maps := import("@platforma-sdk/workflow-tengo:maps")
text := import("text")

common := import(":infer-columns-common")
a := common.a
readColumnSpecs := common.readColumnSpecs
umiColumnSpecs := common.umiColumnSpecs
propertyColumnSpecs := common.propertyColumnSpecs
assemblingFeatures := common.assemblingFeatures
assemblingFeatureLabels := common.assemblingFeatureLabels

// MiXCR header aliases (common column names)
sourceAliases := {
    // Abundance
    "readCount": "read-count",   
    "readFraction": "read-fraction",
    "uniqueMoleculeCount": "umi-count",
    "umiCount": "umi-count",
    "uniqueMoleculeFraction": "umi-fraction",
    // MiXCR 3
    "cloneCount": "read-count",
    "cloneFraction": "read-fraction",
    // MiXCR 3 imputes framework regions from the germline; CDR3 is always read, never imputed
    "nSeqImputedCDR3": "cdr3-nt",
    "aaSeqImputedCDR3": "cdr3-aa",
    // MiXCR 1 and 2 human-readable headers. Their framework columns are left out: these
    // versions wrote an uncovered region empty, which reads as a covered one of zero length.
    "Clone count": "read-count",
    "Clone fraction": "read-fraction",
    "N. Seq. CDR3": "cdr3-nt",
    "AA. seq. CDR3": "cdr3-aa",
    "AA. Seq. CDR3": "cdr3-aa",
    "All V hits": "allVHitsWithScore",
    "All D hits": "allDHitsWithScore",
    "All J hits": "allJHitsWithScore",
    "All C hits": "allCHitsWithScore",
    "Best V hit": "v-allele",
    "Best D hit": "d-allele",
    "Best J hit": "j-allele",
    "Best C hit": "c-allele",

    // Sequences
    "nSeqCDR3": "cdr3-nt",
    "aaSeqCDR3": "cdr3-aa",
    "nSeqFR1": "fr1-nt",
    "nSeqCDR1": "cdr1-nt",
    "nSeqCDR2": "cdr2-nt",
    "nSeqFR2": "fr2-nt",
    "nSeqFR3": "fr3-nt",
    "nSeqFR4": "fr4-nt",
    "aaSeqFR1": "fr1-aa",
    "aaSeqCDR1": "cdr1-aa",
    "aaSeqFR2": "fr2-aa",
    "aaSeqCDR2": "cdr2-aa",
    "aaSeqFR3": "fr3-aa",
    "aaSeqFR4": "fr4-aa",
    "nSeqVDJRegion": "vdj-nt",
    "aaSeqVDJRegion": "vdj-aa",
    "isotype": "isotype",

    // Best genes (desired outputs)
    "bestVGene": "v-gene",
    "bestDGene": "d-gene",
    "bestJGene": "j-gene",
    "bestCGene": "c-gene",

    // Best alleles
    "bestVHit": "v-allele",
    "bestDHit": "d-allele",
    "bestJHit": "j-allele",
    "bestCHit": "c-allele",

    // Alternate inputs that may require conversion to bestXGene
    "allVHitsWithScore": "allVHitsWithScore",
    "allDHitsWithScore": "allDHitsWithScore",
    "allJHitsWithScore": "allJHitsWithScore",
    "allCHitsWithScore": "allCHitsWithScore",

    "allVHits": "allVHits",
    "allDHits": "allDHits",
    "allJHits": "allJHits",
    "allCHits": "allCHits",

    "allVGenes": "allVGenes",
    "allDGenes": "allDGenes",
    "allJGenes": "allJGenes",
    "allCGenes": "allCGenes"
}

// Widest first: what is keyed on when the scientist did not choose
AUTO_FEATURES := ["VDJRegion", "{FR1Begin:CDR3End}"]

getColumns := func(header, ...opts) {
	options := len(opts) > 0 && !is_undefined(opts[0]) ? opts[0] : {}

	columnMapping := {}
	for h in header {
		s := sourceAliases[h]
		if s != undefined && columnMapping[s] == undefined {
			columnMapping[s] = h
		}
	}

	// MiXCR writes tagValueCELL; older or hand-edited exports vary the case or add a suffix
	cellTagColumns := []
	for h in header {
		if text.re_match("^(?i)tagValueCell", h) && columnMapping[h] == undefined {
			cellTagColumns = append(cellTagColumns, h)
			columnMapping[h] = h
		}
	}

	hasReads := columnMapping["read-count"] != undefined
	hasUMIs := columnMapping["umi-count"] != undefined
	abundanceColumns := {}
	if hasReads { abundanceColumns = maps.merge(abundanceColumns, readColumnSpecs) }
	if hasUMIs { abundanceColumns = maps.merge(abundanceColumns, umiColumnSpecs) }
	mainAbundance := hasUMIs ? "umi" : "read"
	if hasReads || hasUMIs {
		abundanceColumns[mainAbundance + "-count"].spec.annotations["pl7.app/abundance/isPrimary"] = "true"
		abundanceColumns[mainAbundance + "-count"].spec.annotations["pl7.app/isAnchor"] = "true"
		abundanceColumns[mainAbundance + "-fraction"].spec.annotations["pl7.app/abundance/isPrimary"] = "true"
	}

	// The regions a feature spans, or undefined when the file lacks one of them
	spanFor := func(feature, suffix) {
		// An exported VDJRegion is that span already
		if feature == "VDJRegion" && columnMapping["vdj" + suffix] != undefined { return ["vdj" + suffix] }
		ids := []
		for r in assemblingFeatures[feature] {
			if columnMapping[r + suffix] == undefined { return undefined }
			ids = append(ids, r + suffix)
		}
		return ids
	}

	// The chosen feature when the file carries it; otherwise the widest one it does, or CDR3
	feature := "CDR3"
	requested := options.assemblingFeature
	if !is_undefined(requested) && !is_undefined(assemblingFeatures[requested]) && !is_undefined(spanFor(requested, "-nt")) {
		feature = requested
	} else {
		for f in AUTO_FEATURES {
			if feature == "CDR3" && !is_undefined(spanFor(f, "-nt")) { feature = f }
		}
	}
	// An exported VDJRegion would collide with a narrower span assembled under the same column
	if feature != "VDJRegion" && feature != "CDR3" {
		delete(columnMapping, "vdj-nt")
		delete(columnMapping, "vdj-aa")
	}
	spanNt := undefined
	spanAa := undefined
	if feature != "CDR3" {
		spanNt = spanFor(feature, "-nt")
		spanAa = spanFor(feature, "-aa")
	}

	// A fresh copy, so the shared spec map carries no mark into the next call
	marked := func(col) {
		return maps.deepMerge(col, { spec: { annotations: {
			"pl7.app/vdj/isMainSequence": "true",
			"pl7.app/vdj/isAssemblingFeature": "true"
		} } })
	}

	propertyColumns := [
		is_undefined(spanNt) ? marked(propertyColumnSpecs["cdr3-nt"]) : propertyColumnSpecs["cdr3-nt"],
		is_undefined(spanAa) ? marked(propertyColumnSpecs["cdr3-aa"]) : propertyColumnSpecs["cdr3-aa"],
		propertyColumnSpecs["cdr3-aa-length"],
		propertyColumnSpecs["cdr3-nt-length"],
		propertyColumnSpecs["is-productive"],
		propertyColumnSpecs["v-gene"],
		propertyColumnSpecs["d-gene"],
		propertyColumnSpecs["j-gene"],
		propertyColumnSpecs["c-gene"]
	]
	for g in ["V", "D", "J", "C"] {
		l := text.to_lower(g)
		if columnMapping[l + "-allele"] != undefined || columnMapping["all" + g + "Hits"] != undefined || columnMapping["all" + g + "HitsWithScore"] != undefined {
			propertyColumns = append(propertyColumns, propertyColumnSpecs[l + "-allele"])
		}
	}
	for k in [
		"fr1-nt", "cdr1-nt", "fr2-nt", "cdr2-nt", "fr3-nt", "fr4-nt",
		"fr1-aa", "cdr1-aa", "fr2-aa", "cdr2-aa", "fr3-aa", "fr4-aa", "isotype"
	] {
		if columnMapping[k] != undefined { propertyColumns = append(propertyColumns, propertyColumnSpecs[k]) }
	}

	if feature == "CDR3" {
		for k in ["vdj-nt", "vdj-aa"] {
			if columnMapping[k] != undefined { propertyColumns = append(propertyColumns, propertyColumnSpecs[k]) }
		}
	}

	// Assembled in the import template from the regions the feature names
	if !is_undefined(spanNt) { propertyColumns = append(propertyColumns, marked(common.spanColumnSpec("nucleotide", feature))) }
	if !is_undefined(spanAa) { propertyColumns = append(propertyColumns, marked(common.spanColumnSpec("aminoacid", feature == "VDJRegion" ? "VDJRegionInFrame" : feature))) }

	// The feature, V and J identify a clonotype; an exported best C gene splits isotypes
	keyColumns := [is_undefined(spanNt) ? "cdr3-nt" : "vdj-nt", "v-gene", "j-gene"]
	keyStructure := (is_undefined(spanNt) ? "CDR3-nt" : feature) + "-VGene-JGene"
	if columnMapping["c-gene"] != undefined {
		keyColumns = append(keyColumns, "c-gene")
		keyStructure = keyStructure + "-CGene"
	}

	return {
		hasUMIs: hasUMIs,
		abundanceColumns: maps.getValues(abundanceColumns),
		propertyColumns: propertyColumns,
		columnMapping: columnMapping,
		clonotypeKeyStructure: keyStructure,
		clonotypeKeyColumns: keyColumns,
		cellTagColumns: cellTagColumns,
		isSingleCell: len(cellTagColumns) > 0,
		assemblingFeature: feature,
		assemblingFeatureLabel: assemblingFeatureLabels[feature],
		spanNt: spanNt,
		spanAa: spanAa
	}
}

export {
	getColumns: getColumns
}
