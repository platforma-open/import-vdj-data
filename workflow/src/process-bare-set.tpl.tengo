// Assemble a bare paired set into one p-frame.
//
// One `processColumn` pass, not two. The per-chain path takes a second pass to compute
// cross-sample aggregates — `pl7.app/vdj/sampleCount` and the `…CountTotal` / `…FractionMean`
// pair — and a bare set emits none of them: a count of how often a record repeats must never
// be presented as an abundance, and a total of a constant is the number of samples wearing an
// abundance label. Since every emitted column sits on `[pl7.app/sampleId, pl7.app/variantKey]`
// with nothing collapsing across samples, the second pass has no work left to do.
//
// Suppressing those columns is therefore not a filter applied at the end — the pass that
// computed them is simply absent.

self := import("@platforma-sdk/workflow-tengo:tpl")

ll := import("@platforma-sdk/workflow-tengo:ll")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
assets := import("@platforma-sdk/workflow-tengo:assets")
processUtils := import(":process-utils")
specs := import(":bare-set-specs")

importTpl := assets.importTemplate(":import-bare-set")
annotateTpl := assets.importTemplate(":annotate-regions")

self.awaitState("InputsLocked")
self.awaitState("datasetData", "ResourceReady")

self.body(func(inputs) {
	datasetSpec := inputs.datasetSpec
	dataset := inputs.datasetData
	blockId := inputs.blockId
	chains := inputs.chains
	scheme := inputs.scheme
	mapping := inputs.mapping
	properties := inputs.properties
	if properties == undefined { properties = [] }

	ll.assert(len(chains) > 0, "process-bare-set: at least one chain must be mapped")

	keyAxis := specs.keyAxis(blockId)
	// Both TSVs are keyed on the same axis and land in the same frame; the split is only
	// about which file each column is read from.
	bySource := specs.columnsBySource(chains, scheme, properties)

	results := pframes.processColumn(
		{ spec: datasetSpec, data: dataset },
		importTpl,
		[
			{
				type: "Xsv",
				xsvType: "tsv",
				settings: {
					axes: [keyAxis],
					columns: bySource.records,
					storageFormat: "Parquet",
					partitionKeyLength: 0
				},
				mem: "16GiB",
				cpu: 2,
				name: "records",
				path: ["records", "main"]
			},
			{
				type: "Resource",
				spec: {
					kind: "PColumn",
					name: "mixcr.com/clonotypeTable",
					valueType: "File"
				},
				name: "recordsTsv",
				path: ["records", "main"]
			}
		],
		{
			// The sample axis is not declared by this block on this door — it arrives from the
			// dataset's own partition, so every emitted column ends up on
			// [pl7.app/sampleId, pl7.app/variantKey]. On the direct door import declares it
			// itself; the emitted shape is identical either way.
			aggregate: [{
				name: "pl7.app/sequencing/lane",
				optional: true
			}, {
				name: "pl7.app/sequencing/tag",
				optional: true
			}],
			passAggregationAxesNames: true,

			traceSteps: [{
				type: "milaboratories.importVDJ",
				id: blockId,
				importance: 81,
				label: "Import V(D)J Data"
			}],

			extra: {
				mapping: mapping,
				properties: properties,
				chains: chains,
				scheme: scheme,
				xsvType: processUtils.applyXsvType({ xsvType: "tsv" }, datasetSpec).xsvType
			}
		}
	)

	// Second pass: ANARCI over each sample's record TSV. Separate from the first because a
	// processColumn body is re-rendered per declared output and exec construction is not
	// reproducible, so polars and execs cannot share one body.
	annotated := pframes.processColumn(
		results.output("recordsTsv"),
		annotateTpl,
		[{
			type: "Xsv",
			xsvType: "tsv",
			settings: {
				axes: [keyAxis],
				columns: bySource.regions,
				storageFormat: "Parquet",
				partitionKeyLength: 0
			},
			mem: "16GiB",
			cpu: 2,
			name: "regions",
			path: ["regions", "main"]
		}, {
			type: "TsvContent",
			settings: {
				axes: [specs.statsAxis()],
				columns: specs.statsColumns(blockId)
			},
			name: "regionStats",
			path: ["stats", "main"]
		}],
		{
			// No traceSteps: this pass consumes the first pass's output and inherits its step.
			// Adding it again put the same import step in the trace twice, which the region
			// columns showed as a duplicated provenance entry.
			extra: {
				keyColumn: specs.keyColumn,
				scheme: scheme
			}
		}
	)

	result := pframes.pFrameBuilder()
	results.addXsvOutputToBuilder(result, "records", "records")
	annotated.addXsvOutputToBuilder(result, "regions", "regions")

	stats := pframes.pFrameBuilder()
	annotated.addXsvOutputToBuilder(stats, "regionStats", "regionStats")

	return {
		result: result.build(),
		stats: stats.build()
	}
})
