maps := import("@platforma-sdk/workflow-tengo:maps")
json := import("json")

columnsToSchema := func(columns) {
	schema := []
	for col in columns {
		schema += [ { column: col.column, type: col.spec.valueType } ]
	}
	return schema
}

buildStatsColumns := func(chain, blockId, columnsInfo) {
	statsColumns := [
		{
			id: "clonotype-count",
			column: "clonotype-count",
			spec: {
				name: "pl7.app/vdj/stat/clonotypeCount",
				valueType: "Int",
				domain: {
					"pl7.app/vdj/chain": chain,
					"pl7.app/vdj/clonotypingRunId": blockId
				},
				annotations: {
					"pl7.app/label": "Number of Clonotypes",
					"pl7.app/description": "The number of clonotypes in the dataset.",
					"pl7.app/table/visibility": "default"
				}
			}
		}
	]
	// From what is emitted, not the header: an import may build its read count from other columns
	hasReads := false
	for col in columnsInfo.abundanceColumns { if col.column == "read-count" { hasReads = true } }
	if hasReads {
		statsColumns += [
			{
				id: "read-count",
				column: "read-count",
				spec: {
					name: "pl7.app/vdj/stat/readCount",
					valueType: "Long",
					domain: {
						"pl7.app/vdj/chain": chain,
					"pl7.app/vdj/clonotypingRunId": blockId
					},
					annotations: {
						"pl7.app/label": "Number of Reads",
						"pl7.app/description": "The number of reads in the dataset.",
						"pl7.app/table/visibility": "default"
					}
				}
			}
		]
	}
	if columnsInfo.hasUMIs {
		statsColumns += [
			{
				id: "umi-count",
				column: "umi-count",
				spec: {
					name: "pl7.app/vdj/stat/umiCount",
					valueType: "Long",
					domain: {
						"pl7.app/vdj/chain": chain,
						"pl7.app/vdj/clonotypingRunId": blockId
					},
					annotations: {
						"pl7.app/label": "Number of UMIs",
						"pl7.app/description": "The number of UMIs in the dataset.",
						"pl7.app/table/visibility": "default"
					}
				}
			}
		]
	}
	return statsColumns
}

// The trace the dataset-level stats carry. Named after what was read, as the bare-set path is:
// the label is what a downstream dropdown shows, and it has no chain to name.
recordStatsTrace := func(blockId, formatSpec) {
	return [{ type: "milaboratories.importVDJ", id: blockId, importance: 81, label: formatSpec.label }]
}

// Whether a gene call reaches the frame at all, by mapping or by MiXCR's own derivation.
// Shared so the specs and the expressions filling them cannot disagree about which exist.
hasGene := func(columnsInfo, alleleMode, prefix) {
	m := columnsInfo.columnMapping
	if m[prefix + "-gene"] != undefined { return true }
	if alleleMode != "mixcr" { return false }
	upper := prefix == "v" ? "V" : prefix == "d" ? "D" : prefix == "j" ? "J" : "C"
	for key in [prefix + "-allele", "all" + upper + "HitsWithScore", "all" + upper + "Hits", "all" + upper + "Genes"] {
		if m[key] != undefined { return true }
	}
	return false
}

// One per-sample row counter: no chain in the domain, since a discarded row belongs to none.
// Shared with the bare-set path, so the counters both paths emit are the same columns.
recordStatColumn := func(blockId, id, name, label, description, visibility, order) {
	return {
		id: id,
		column: id,
		spec: {
			name: "pl7.app/vdj/stat/" + name,
			valueType: "Long",
			domain: { "pl7.app/vdj/clonotypingRunId": blockId },
			annotations: {
				"pl7.app/label": label,
				"pl7.app/description": description,
				"pl7.app/table/visibility": visibility,
				"pl7.app/table/orderPriority": order
			}
		}
	}
}

// The count every discard counter is a share of; first in the table.
rowsReadColumn := func(blockId, id) {
	return recordStatColumn(blockId, id, "recordCount", "Rows Read",
		"Rows from this sample.", "default", "100000")
}

// What the row filters discarded, per sample and across every chain -- a row with no V call
// belongs to no chain, and each count is its own filter's cost, not an overlapping total.
buildRecordStatsColumns := func(blockId, columnsInfo, alleleMode, productivityMode) {
	// Descending, so the table reads left to right in the order the filters actually run
	col := func(id, name, label, description, visibility, order) {
		return recordStatColumn(blockId, id, name, label, description, visibility, order)
	}

	cols := [rowsReadColumn(blockId, "record-count")]
	if columnsInfo.columnMapping["is-cell"] != undefined || columnsInfo.columnMapping["high-confidence"] != undefined {
		cols += [col("records-not-cell", "recordsNotCell", "Discarded: Not a Cell",
			"Rows discarded because their barcode was not called a cell or the contig was not high-confidence.", "optional", "99500")]
	}
	if hasGene(columnsInfo, alleleMode, "v") {
		cols += [col("records-no-v", "recordsWithoutVGene", "Discarded: No V Gene",
			"Rows discarded because no V gene was called.", "optional", "99000")]
	}
	if hasGene(columnsInfo, alleleMode, "j") {
		cols += [col("records-no-j", "recordsWithoutJGene", "Discarded: No J Gene",
			"Rows discarded because no J gene was called, among those that had a V gene.", "optional", "98000")]
	}
	if columnsInfo.columnMapping["cdr3-nt"] != undefined {
		cols += [col("records-no-cdr3", "recordsWithoutCdr3", "Discarded: No CDR3",
			"Rows discarded because no CDR3 could be read, among those that had V and J genes.", "optional", "97000")]
	}
	// Emitted only when a feature was assembled: with a CDR3 key nothing can fail to cover it
	if !is_undefined(columnsInfo.spanNt) {
		feature := columnsInfo.assemblingFeatureLabel
		cols += [col("records-not-covering", "recordsNotCoveringAssemblingFeature",
			"Discarded: Not Covering " + feature,
			"Rows discarded because they do not span " + feature + ", among those that had V and J genes and a CDR3.",
			"default", "96000")]
	}
	if productivityMode == "from_cdr3_aa" || productivityMode == "from_column_true" || productivityMode == "from_column_or_cdr3_aa" {
		why := productivityMode == "from_cdr3_aa" ? "their CDR3 has a stop codon or a frameshift" :
			productivityMode == "from_column_true" ? "the file marks them not productive" :
			"the file marks them not productive or, where it does not say, their CDR3 has a stop codon or a frameshift"
		cols += [col("records-not-productive", "recordsNotProductive", "Discarded: Not Productive",
			"Rows discarded because " + why + ", among those kept so far.", "optional", "95000")]
	}
	return cols
}

toCombinedDomainValue := func(spec) {
	result := [spec.name]
	if is_undefined(spec.domain) { return result }
	for domain in maps.getKeys(spec.domain) {
		result = append(result, [domain, spec.domain[domain]])
	}
	return result
}

buildClonotypeKeyStructure := func(columnsInfo, keyColumns) {
	if keyColumns == undefined { return string(json.encode([])) }
	columnsByName := {}
	for col in columnsInfo.propertyColumns { columnsByName[col.column] = col }
	for col in columnsInfo.abundanceColumns { columnsByName[col.column] = col }
	keyStructure := []
	for keyColumn in keyColumns {
		columnSpec := columnsByName[keyColumn]
		if !is_undefined(columnSpec) && !is_undefined(columnSpec.spec) {
			keyStructure = append(keyStructure, toCombinedDomainValue(columnSpec.spec))
		}
	}
	return string(json.encode(keyStructure))
}

applyXsvType := func(importCfg, datasetSpec) {
	if is_undefined(datasetSpec) || is_undefined(datasetSpec.domain) { return importCfg }
	fileExtension := datasetSpec.domain["pl7.app/fileExtension"]
	if is_undefined(fileExtension) { return importCfg }
	cfg := importCfg
	if is_undefined(cfg) { cfg = {} }
	if fileExtension == "csv" || fileExtension == "csv.gz" {
		cfg.xsvType = "csv"
	} else if fileExtension == "tsv" || fileExtension == "tsv.gz" {
		cfg.xsvType = "tsv"
	}
	return cfg
}

export {
	columnsToSchema: columnsToSchema,
	buildStatsColumns: buildStatsColumns,
	buildRecordStatsColumns: buildRecordStatsColumns,
	recordStatColumn: recordStatColumn,
	rowsReadColumn: rowsReadColumn,
	hasGene: hasGene,
	recordStatsTrace: recordStatsTrace,
	buildClonotypeKeyStructure: buildClonotypeKeyStructure,
	applyXsvType: applyXsvType
}
