// Prerun check of a bare set: id collisions, and the rows that will not become records.
// One file read and one polars run, so both answers arrive together.
//
// Rows with no id, or no sequence on a mapped chain (null, empty or whitespace, as the
// annotation pass reads it), are ignored by the import, so they are only counted.
//
// collisions: ids on rows with an id and every sequence that are not identical. Rows are compared over
// every column, so a stray differing column makes a conflict; only verbatim repeats collapse.
//
// row report (once a sequence is mapped): rows without an id, rows with an id but without a
// sequence, then verbatim repeats among the rest.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
specs := import(":bare-set-specs")

COUNT_COLUMN := "rowCount"
MISSING := "missingSequence"
MISSING_ID := "missingId"

self.defineOutputs("collisions", "summary", "missing", "collapsed")

self.body(func(inputs) {
	dataset := inputs.dataset
	mapping := inputs.mapping

	ll.assert(mapping != undefined, "bare-set-collisions: mapping is required")
	ll.assert(
		mapping.identity != undefined && mapping.identity != "",
		"bare-set-collisions: an identity column must be selected"
	)

	// Chain order keeps the plan reproducible.
	sequenceHeaders := []
	if mapping.sequences != undefined {
		for chain in specs.CHAINS {
			header := mapping.sequences[chain]
			if header != undefined && header != "" {
				sequenceHeaders = append(sequenceHeaders, header)
			}
		}
	}

	fileExtension := dataset.spec.domain["pl7.app/fileExtension"]
	xsvType := "tsv"
	if fileExtension == "csv" || fileExtension == "csv.gz" {
		xsvType = "csv"
	}

	wf := pt.workflow().mem("4GiB").cpu(2)

	frames := []
	inputMap := dataset.data.inputs()
	for key in maps.getKeys(inputMap) {
		frames = append(frames, wf.frame(inputMap[key], {
			xsvType: xsvType,
			id: "table_" + key,
			// Strings only: compare what the file wrote ("1" vs "1.0").
			inferSchema: false
		}))
	}
	ll.assert(len(frames) > 0, "bare-set-collisions: no input files found")

	df := pt.concat(frames)

	blank := func(header) {
		return pt.col(header).fillNull("").strReplace("\\s+", "", { replaceAll: true }).eq("")
	}
	// No id has no record to land in: the import drops the row rather than minting a shared key.
	missingIdExpr := blank(mapping.identity)
	// With no sequence mapped nothing counts as missing.
	missingExpr := pt.lit(false)
	for i, header in sequenceHeaders {
		if i == 0 {
			missingExpr = blank(header)
		} else {
			missingExpr = missingExpr.or(blank(header))
		}
	}
	// A row without an id counts there only, not again as missing a sequence.
	missingSequenceExpr := missingIdExpr.not().and(missingExpr)
	withSequences := df.filter(missingIdExpr.or(missingExpr).not())

	// Collisions, among rows with an id and every sequence: the others are ignored by the import.
	// keep/maintainOrder pinned for a reproducible plan; grouped on the source header.
	collisions := withSequences.unique({ keep: "first", maintainOrder: true }).
		groupBy(mapping.identity).agg(
			pt.col(mapping.identity).count().alias(COUNT_COLUMN)
		).
		filter(pt.col(COUNT_COLUMN).gt(pt.lit(1))).
		select(pt.col(mapping.identity).alias(specs.labelColumn))
	collisions.saveContent("collisions.tsv")

	summary := df.withColumns(
		pt.when(missingSequenceExpr).then(pt.lit(1)).otherwise(pt.lit(0)).alias(MISSING),
		pt.when(missingIdExpr).then(pt.lit(1)).otherwise(pt.lit(0)).alias(MISSING_ID),
		pt.lit("all").alias("group")
	).groupBy("group").agg(
		pt.col(MISSING).count().alias(COUNT_COLUMN),
		pt.col(MISSING).sum().alias(MISSING),
		pt.col(MISSING_ID).sum().alias(MISSING_ID)
	).select(COUNT_COLUMN, MISSING, MISSING_ID)
	summary.saveContent("summary.tsv")

	// Distinct ids of rows without a sequence; rows with no id are only counted.
	missing := df.filter(missingSequenceExpr).
		select(pt.col(mapping.identity).alias(specs.labelColumn)).
		unique({ keep: "first", maintainOrder: true }).
		sort([specs.labelColumn])
	missing.saveContent("missing.tsv")

	// Ids whose rows (with sequences) are all verbatim repeats; differing rows are collisions.
	rows := withSequences.groupBy(mapping.identity).agg(
		pt.col(mapping.identity).count().alias(COUNT_COLUMN)
	)
	distinct := withSequences.unique({ keep: "first", maintainOrder: true }).
		groupBy(mapping.identity).agg(
			pt.col(mapping.identity).count().alias("distinctCount")
		)
	collapsed := rows.join(distinct, { how: "inner", on: [mapping.identity] }).
		filter(pt.col(COUNT_COLUMN).gt(pt.lit(1)).and(pt.col("distinctCount").eq(pt.lit(1)))).
		// Most-repeated first, so a truncated list names them.
		sort([COUNT_COLUMN, mapping.identity], { descending: [true, false] }).
		select(pt.col(mapping.identity).alias(specs.labelColumn), pt.col(COUNT_COLUMN))
	collapsed.saveContent("collapsed.tsv")

	wf = wf.run()

	return {
		collisions: wf.getFileContent("collisions.tsv"),
		summary: wf.getFileContent("summary.tsv"),
		missing: wf.getFileContent("missing.tsv"),
		collapsed: wf.getFileContent("collapsed.tsv")
	}
})
