// Collapse the per-sample record TSVs into one label per record.
//
// A `pl7.app/label` column only acts as an axis label when it sits on that axis alone. Emitted
// on `[pl7.app/sampleId, pl7.app/variantKey]` it is merely a per-record property, and the axis
// goes on showing the opaque hash — which defeats the point of putting the scientist's own
// identifier on the record at all.
//
// So this pass aggregates the sample axis away and writes the label keyed on the record alone.
// It is the same shape the per-chain path uses for its own properties, and the same shape
// samples-and-data uses for its sample labels.
//
// The identity is unique per record and identical in every sample it appears in, so collapsing
// is lossless: `first` over a group of equal values.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
specs := import(":bare-set-specs")

self.defineOutputs("tsv")

self.body(func(inputs) {
	inputData := inputs[pConstants.VALUE_FIELD_NAME]
	inputMap := inputData.inputs()
	ll.assert(len(inputMap) > 0, "aggregate-record-labels: no per-sample record TSVs")

	wf := pt.workflow().mem("4GiB").cpu(2)

	frames := []
	// Sorted iteration: frame order reaches the polars schema and therefore the output bytes.
	for key in maps.getKeys(inputMap) {
		frames = append(frames, wf.frame(inputMap[key], {
			xsvType: "tsv",
			id: "labels_" + key,
			inferSchema: false
		}))
	}

	df := pt.concat(frames).select(specs.keyColumn, specs.labelColumn)

	// keep and maintainOrder pinned: the default keep is order-dependent, which makes the plan
	// non-reproducible and breaks dedup of everything downstream.
	df = df.unique({ subset: specs.keyColumn, keep: "first", maintainOrder: true })

	df.save("labels.tsv")
	wf = wf.run()

	return {
		tsv: { main: wf.getFile("labels.tsv") }
	}
})
