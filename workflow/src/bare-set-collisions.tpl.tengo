// Find identity values that appear on rows which are not identical.
//
// Runs in prerun because the answer decides whether the run may start. The record key is the
// hash of the identity column, so a repeated identity merges two antibodies silently.
//
// Rows are compared over EVERY column of the file, not the ones the import keeps: the question
// is whether the chosen column identifies a record, and two rows given one name while
// disagreeing anywhere are two different things. Only a verbatim repeat collapses. So the
// verdict depends on the file and the id column alone — nothing else in the mapping — which is
// why `collisionCheckKey` names just the id and why this runs before any sequence is mapped.
//
// The cost: a column nobody imports decides the verdict, so a row counter or a stray trailing
// space makes every repeated id a conflict. Intended, but it leaves the verbatim-repeat branch
// rare in files carrying a per-row unique column.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
specs := import(":bare-set-specs")

COUNT_COLUMN := "rowCount"

self.defineOutputs("collisions")

self.body(func(inputs) {
	dataset := inputs.dataset
	mapping := inputs.mapping

	ll.assert(mapping != undefined, "bare-set-collisions: mapping is required")
	ll.assert(
		mapping.identity != undefined && mapping.identity != "",
		"bare-set-collisions: an identity column must be selected"
	)

	fileExtension := dataset.spec.domain["pl7.app/fileExtension"]
	xsvType := "tsv"
	if fileExtension == "csv" || fileExtension == "csv.gz" {
		xsvType = "csv"
	}

	wf := pt.workflow().mem("4GiB").cpu(2)

	frames := []
	inputMap := dataset.data.inputs()
	for key in maps.getKeys(inputMap) {
		frames = append(frames, wf.frame(inputMap[key], {
			xsvType: xsvType,
			id: "table_" + key,
			// Every column as a string, so the comparison is over what the file actually wrote.
			// Inference would let a guess about the schema decide whether "1" and "1.0" differ.
			inferSchema: false
		}))
	}
	ll.assert(len(frames) > 0, "bare-set-collisions: no input files found")

	df := pt.concat(frames)

	// No `select` before this: the subset is every column the file has. keep and maintainOrder
	// are pinned — the default keep is order-dependent, which makes the polars plan
	// non-reproducible and silently breaks dedup downstream.
	df = df.unique({ keep: "first", maintainOrder: true })

	// Grouped on the source header: renaming the id column would replace a column of the raw row
	// and change the very thing compared above.
	df = df.groupBy(mapping.identity).agg(
		pt.col(mapping.identity).count().alias(COUNT_COLUMN)
	)
	df = df.filter(pt.col(COUNT_COLUMN).gt(pt.lit(1)))
	df = df.select(pt.col(mapping.identity).alias(specs.labelColumn))

	df.saveContent("collisions.tsv")
	wf = wf.run()

	return {
		collisions: wf.getFileContent("collisions.tsv")
	}
})
