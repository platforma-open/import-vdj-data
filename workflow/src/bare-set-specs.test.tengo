test := import("@platforma-sdk/workflow-tengo:test")
specs := import(":bare-set-specs")

byId := func(columns, id) {
	for c in columns {
		if c.id == id {
			return c
		}
	}
	return undefined
}

ids := func(columns) {
	out := []
	for c in columns {
		out = append(out, c.id)
	}
	return out
}

// --- key axis ---------------------------------------------------------------------------

Test_keyAxis_isVariantKeyWithRunIdAndReceptor := func() {
	axis := specs.keyAxis("block-42", ["A", "B"])

	test.isEqual("pl7.app/variantKey", axis.spec.name, "key axis name")
	test.isEqual("String", axis.spec.type, "key axis type")
	test.isEqual({
		"pl7.app/vdj/receptor": "IG",
		"pl7.app/vdj/clonotypingRunId": "block-42"
	}, axis.spec.domain, "key axis domain")
}

// The run-id key is what makes a set on this shared axis antibody rather than peptide or
// amplicon. A reader that takes modality from the axis *name* is wrong; this is the carrier.
Test_keyAxis_carriesTheVdjRunIdAndNotAnotherModalitys := func() {
	domain := specs.keyAxis("b1", ["A", "B"]).spec.domain

	test.isEqual("b1", domain["pl7.app/vdj/clonotypingRunId"], "vdj run id")
	test.isTrue(domain["pl7.app/peptide/extractionRunId"] == undefined, "must not claim peptide")
	test.isTrue(domain["pl7.app/repertoire/extractionRunId"] == undefined, "must not claim amplicon")
}

// `scClonotypeKey/structure` belongs to the vocabulary this axis no longer uses, and no
// variantKey producer in the workspace emits a structure key.
Test_keyAxis_carriesNoStructureKey := func() {
	domain := specs.keyAxis("b1", ["A", "B"]).spec.domain

	test.isTrue(domain["pl7.app/vdj/scClonotypeKey/structure"] == undefined, "no structure key")
	test.isEqual(2, len(domain), "exactly two domain keys when paired")
}

// With one chain the record IS that chain, so the axis says which — the same key and the same
// vocabulary the block's bulk path puts on its clonotypeKey axis. It is the only machine-readable
// statement of the chain on a single-chain set, since the columns carry none.
Test_keyAxis_namesTheChainWhenThereIsOnlyOne := func() {
	heavy := specs.keyAxis("b1", ["A"]).spec.domain
	test.isEqual("IGHeavy", heavy["pl7.app/vdj/chain"], "heavy-only names its locus")
	test.isEqual(3, len(heavy), "run id, receptor and chain")

	light := specs.keyAxis("b1", ["B"]).spec.domain
	test.isEqual("IGLight", light["pl7.app/vdj/chain"], "light-only names its locus")

	// A paired record holds both chains, so no single value applies.
	paired := specs.keyAxis("b1", ["A", "B"]).spec.domain
	test.isTrue(paired["pl7.app/vdj/chain"] == undefined, "paired names no chain")
}

// --- main sequence ----------------------------------------------------------------------

Test_mainSequence_carriesChainAndIndexAndTheTwoAnnotations := func() {
	col := specs.mainSequenceColumn("A", true)

	test.isEqual("pl7.app/vdj/sequence", col.spec.name, "name")
	test.isEqual("aminoacid", col.spec.domain["pl7.app/alphabet"], "alphabet")
	test.isEqual("VDJRegionInFrame", col.spec.domain["pl7.app/vdj/feature"], "feature")
	test.isEqual("A", col.spec.domain["pl7.app/vdj/scClonotypeChain"], "chain")
	test.isEqual("primary", col.spec.domain["pl7.app/vdj/scClonotypeChain/index"], "chain index")

	// Without these two, Lead Selection produces no output and raises no error.
	test.isEqual("true", col.spec.annotations["pl7.app/vdj/isMainSequence"], "isMainSequence")
	test.isEqual("true", col.spec.annotations["pl7.app/vdj/isAssemblingFeature"], "isAssemblingFeature")
}

// A whole variable domain has no located boundary, so it carries no convention.
Test_mainSequence_carriesNoConventionKey := func() {
	col := specs.mainSequenceColumn("B", true)

	test.isTrue(col.spec.domain["pl7.app/vdj/numberingSchema"] == undefined, "no scheme in domain")
	test.isTrue(col.spec.annotations["pl7.app/vdj/numberingSchema"] == undefined, "no scheme annotation")
}

// Two columns whose specs were identical would dedupe into one, and the heavy and light
// sequences would stop being separately addressable. The chain key is what prevents that.
Test_mainSequence_chainsAreDistinctSpecs := func() {
	a := specs.mainSequenceColumn("A", true)
	b := specs.mainSequenceColumn("B", true)

	test.isTrue(a.spec.domain != b.spec.domain, "chain A and B must not share a domain")
	test.isTrue(a.column != b.column, "chain A and B must not share a source column")
}

// --- region columns ----------------------------------------------------------------------

// FR4 is the region every list in the workspace has been missing.
Test_regions_areSevenAndIncludeFR4 := func() {
	test.isEqual(7, len(specs.REGIONS), "seven regions")

	seen := {}
	for r in specs.REGIONS {
		seen[r] = true
	}
	for r in ["FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"] {
		test.isTrue(seen[r] == true, "region " + r + " must be present")
	}
}

// The convention is emitted twice on purpose: the domain copy buys distinct identity, the
// annotation copy is what Sequence Liabilities reads to pick its coordinate map.
Test_region_carriesConventionInDomainAndAnnotation := func() {
	col := specs.regionColumnSpec("A", "CDR3", "kabat", true)

	test.isEqual("kabat", col.spec.domain["pl7.app/vdj/numberingSchema"], "scheme in domain")
	test.isEqual("kabat", col.spec.annotations["pl7.app/vdj/numberingSchema"], "scheme in annotation")
}

Test_region_carriesChainAndFeatureAndIndex := func() {
	col := specs.regionColumnSpec("B", "FR4", "imgt", true)

	test.isEqual("pl7.app/vdj/sequence", col.spec.name, "name")
	test.isEqual("FR4", col.spec.domain["pl7.app/vdj/feature"], "feature")
	test.isEqual("B", col.spec.domain["pl7.app/vdj/scClonotypeChain"], "chain")
	test.isEqual("primary", col.spec.domain["pl7.app/vdj/scClonotypeChain/index"], "chain index")
	test.isEqual("aminoacid", col.spec.domain["pl7.app/alphabet"], "alphabet")
}

// Two inherited quirks carried verbatim rather than silently corrected: CDR2 sorts ahead of
// FR2, and CDR3 sits four orders of magnitude above the rest.
Test_region_ordersAndVisibilityMatchTheContract := func() {
	expect := {
		"FR1": ["46950", "optional"],
		"CDR1": ["46940", "optional"],
		"CDR2": ["46935", "optional"],
		"FR2": ["46930", "optional"],
		"FR3": ["46910", "optional"],
		"FR4": ["46900", "optional"],
		"CDR3": ["99000", "default"]
	}

	for region in specs.REGIONS {
		want := expect[region]
		col := specs.regionColumnSpec("A", region, "imgt", true)
		test.isEqual(want[0], col.spec.annotations["pl7.app/table/orderPriority"], region + " order")
		test.isEqual(want[1], col.spec.annotations["pl7.app/table/visibility"], region + " visibility")
	}
}

// A chain with no located boundaries carries no value — not an empty string.
Test_region_allowsNA := func() {
	test.isTrue(specs.regionColumnSpec("A", "FR1", "imgt", true).allowNA, "regions must allow NA")
}

// A convention-blind query matches every convention, but two sets drawn under different
// conventions must stay separately selectable. Only the domain gives that.
Test_region_schemesProduceDistinctDomains := func() {
	imgt := specs.regionColumnSpec("A", "CDR1", "imgt", true)
	kabat := specs.regionColumnSpec("A", "CDR1", "kabat", true)

	test.isTrue(imgt.spec.domain != kabat.spec.domain, "schemes must not share a domain")
}

// --- status column -------------------------------------------------------------------------

Test_status_isAClosedThreeMemberEnum := func() {
	col := specs.statusColumnSpec("A", "imgt", true)

	test.isEqual("pl7.app/vdj/regionAnnotationStatus", col.spec.name, "name")
	test.isEqual("String", col.spec.valueType, "String, because xsv.importFile rejects Boolean")
	test.isEqual("true", col.spec.annotations["pl7.app/isDiscreteFilter"], "discrete filter")
	test.isEqual(
		"[\"Annotated\",\"Not applicable\",\"Failed\"]",
		col.spec.annotations["pl7.app/discreteValues"],
		"closed enum, success member included"
	)
}

// A null status would restore the ambiguity the column exists to remove.
Test_status_isNeverNull := func() {
	test.isFalse(specs.statusColumnSpec("B", "imgt", true).allowNA, "status must not allow NA")
}

Test_status_isPerChainAndPerScheme := func() {
	a := specs.statusColumnSpec("A", "imgt", true)
	b := specs.statusColumnSpec("B", "imgt", true)
	k := specs.statusColumnSpec("A", "kabat", true)

	test.isTrue(a.spec.domain != b.spec.domain, "one status per chain")
	test.isTrue(a.spec.domain != k.spec.domain, "one status per scheme")
	test.isEqual("46895", a.spec.annotations["pl7.app/table/orderPriority"], "sits between FR4 and isotype")
}

// --- synthetic abundance ---------------------------------------------------------------------

// This exact annotation set is what makes Clustering's bundle query match and what makes the
// dataset selectable in the other four consumers.
Test_abundance_carriesTheTripleAndTheAnchor := func() {
	col := specs.abundanceColumnSpec()
	ann := col.spec.annotations

	test.isEqual("pl7.app/vdj/uniqueMoleculeCount", col.spec.name, "name")
	test.isEqual("Long", col.spec.valueType, "the block's own umi-count type, adopted whole")
	test.isEqual("true", ann["pl7.app/isAbundance"], "isAbundance")
	test.isEqual("false", ann["pl7.app/abundance/normalized"], "normalized false")
	test.isEqual("true", ann["pl7.app/abundance/isPrimary"], "isPrimary")
	test.isEqual("true", ann["pl7.app/isAnchor"], "isAnchor")
	test.isFalse(col.allowNA, "never null")
}

// The spec is the block's own umi-count spec adopted whole, so the unit rides along with it:
// the fabrication is confined to the value, not to what the value is called.
Test_abundance_isTheBlocksOwnUmiCountSpec := func() {
	ann := specs.abundanceColumnSpec().spec.annotations

	test.isEqual("molecules", ann["pl7.app/abundance/unit"], "unit comes with the adopted spec")
	test.isEqual("Number of UMIs", ann["pl7.app/label"], "label comes with the adopted spec")
	test.isEqual("88000", ann["pl7.app/table/orderPriority"], "order comes with the adopted spec")
	test.isTrue(ann["pl7.app/abundance/synthetic"] == undefined, "no synthetic marker, by decision")
	test.isEqual(0, len(specs.abundanceColumnSpec().spec.domain), "empty domain")
}

// --- assembly ---------------------------------------------------------------------------------

Test_allColumns_pairedSetEmitsTwentyColumns := func() {
	columns := specs.allColumns(["A", "B"], "imgt", [])

	// label + abundance + 2 main sequences + 14 regions + 2 statuses
	test.isEqual(20, len(columns), "paired set column count")
}

Test_allColumns_singleChainEmitsHalfTheChainColumns := func() {
	columns := specs.allColumns(["A"], "imgt", [])

	// label + abundance + 1 main sequence + 7 regions + 1 status
	test.isEqual(11, len(columns), "single chain column count")
	test.isTrue(byId(columns, "main-sequence-B") == undefined, "no B columns when B is unmapped")
	test.isTrue(byId(columns, "region-status-B") == undefined, "no B status when B is unmapped")
}

// sampleCount is never emitted: a count of how often a record repeats must not be presented
// as an abundance, and the synthetic column's cross-sample aggregates are suppressed too.
Test_allColumns_omitsSampleCountAndAggregates := func() {
	for c in specs.allColumns(["A", "B"], "imgt", []) {
		test.isTrue(c.spec.name != "pl7.app/vdj/sampleCount", "sampleCount must not be emitted")
		test.isTrue(
			c.spec.name != "pl7.app/vdj/uniqueMoleculeCountTotal",
			"no cross-sample total of the synthetic abundance"
		)
		test.isTrue(
			c.spec.name != "pl7.app/vdj/uniqueMoleculeFractionMean",
			"no cross-sample mean of the synthetic abundance"
		)
	}
}

// Exactly one column may claim to be the anchor and primary abundance.
Test_allColumns_hasExactlyOneAnchor := func() {
	anchors := 0
	primaries := 0
	for c in specs.allColumns(["A", "B"], "imgt", []) {
		if c.spec.annotations["pl7.app/isAnchor"] == "true" {
			anchors = anchors + 1
		}
		if c.spec.annotations["pl7.app/abundance/isPrimary"] == "true" {
			primaries = primaries + 1
		}
	}

	test.isEqual(1, anchors, "exactly one anchor column")
	test.isEqual(1, primaries, "exactly one primary abundance")
}

// Pure templates downstream dedup on their inputs, so equal inputs must give byte-equal
// output. Map iteration anywhere in assembly would break this silently.
Test_allColumns_isCanonical := func() {
	first := ids(specs.allColumns(["A", "B"], "kabat", []))
	second := ids(specs.allColumns(["A", "B"], "kabat", []))

	test.isEqual(first, second, "column order must be stable across calls")
}

// Every emitted column must be addressable on its own: no two may share a source column.
Test_allColumns_sourceColumnsAreUnique := func() {
	seen := {}
	for c in specs.allColumns(["A", "B"], "imgt", []) {
		test.isTrue(seen[c.column] == undefined, "duplicate source column " + c.column)
		seen[c.column] = true
	}
}


// --- imported property columns ----------------------------------------------------------------

// The name carries the header sanitized; the label carries it exactly as the file wrote it.
// A raw header in a name would put spaces and punctuation into an identifier every downstream
// query matches on.
Test_importedProperty_sanitizesTheNameAndKeepsTheLabelRaw := func() {
	col := specs.importedPropertyColumn({ header: "Target (nM)" }, 0)

	test.isEqual("pl7.app/vdj/importedProperty/Target_nM_", col.spec.name, "sanitized name")
	test.isEqual("Target (nM)", col.spec.annotations["pl7.app/label"], "label is the raw header")
	test.isEqual("String", col.spec.valueType, "always String — no type is asked for or guessed")
	test.isEqual(0, len(col.spec.domain), "no domain key")
}

// Visible by default: the scientist turns off what they do not want to see.
Test_importedProperty_isVisibleAndSitsBelowTheIdentifier := func() {
	col := specs.importedPropertyColumn({ header: "Clone" }, 0)

	test.isEqual("default", col.spec.annotations["pl7.app/table/visibility"], "visible by default")
	// Below the label column (109000) and the key axis (110000), above the regions.
	test.isEqual("108000", col.spec.annotations["pl7.app/table/orderPriority"], "just under the identifier")
}

// Their specs would otherwise be identical and dedupe into one, losing a column the scientist
// explicitly chose to import.
Test_importedProperty_headersThatSanitizeAlikeCollide := func() {
	collisions := specs.propertyCollisions([
		{ header: "Target nM" },
		{ header: "Target-nM" }
	])

	test.isEqual(1, len(collisions), "one colliding token")
	test.isEqual(["Target nM", "Target-nM"], collisions["Target_nM"], "both headers named")
}

// The contract atom cites `Target (nM)` and `Target-nM` as a colliding pair. Under the
// sanitizer it names, they are NOT: a trailing `)` leaves a trailing `_`, so the tokens are
// `Target_nM_` and `Target_nM`. The mechanism is right and the example is wrong; pinned here
// so the next reader does not "fix" the code to match the prose.
Test_importedProperty_theAtomsCitedPairDoesNotActuallyCollide := func() {
	collisions := specs.propertyCollisions([
		{ header: "Target (nM)" },
		{ header: "Target-nM" }
	])

	test.isEqual(0, len(collisions), "trailing punctuation leaves a trailing underscore")
}

Test_importedProperty_distinctHeadersDoNotCollide := func() {
	collisions := specs.propertyCollisions([
		{ header: "Target" },
		{ header: "Assay" }
	])

	test.isEqual(0, len(collisions), "no collisions")
}

Test_allColumns_includesAcceptedProperties := func() {
	base := specs.allColumns(["A", "B"], "imgt", [])
	withProps := specs.allColumns(["A", "B"], "imgt", [
		{ header: "Target" },
		{ header: "Assay" }
	])

	test.isEqual(len(base) + 2, len(withProps), "two extra columns")
	test.isTrue(byId(withProps, "imported-property-Target") != undefined, "Target emitted")
	test.isTrue(byId(withProps, "imported-property-Assay") != undefined, "Assay emitted")
}


// The convention for a column that labels an axis: the pl7.app/label name, a display name and
// isLabel — and no visibility or order priority, which would make it a table column of its own
// showing the same text a second time beside the axis it names.
Test_recordLabel_followsTheAxisLabelConvention := func() {
	col := specs.labelColumnSpec()

	test.isEqual("pl7.app/label", col.spec.name, "name")
	test.isEqual("true", col.spec.annotations["pl7.app/isLabel"], "isLabel")
	test.isEqual("Record ID", col.spec.annotations["pl7.app/label"], "display name")
	test.isTrue(
		col.spec.annotations["pl7.app/table/visibility"] == undefined,
		"a label column is not also a column of its own"
	)
	test.isTrue(col.spec.annotations["pl7.app/table/orderPriority"] == undefined, "no order")
}


// The dataset's shape, pinned. Abundance is the only column that keeps the sample axis;
// everything else is a property of the record and is collapsed onto the record axis.
//
// This is not a stylistic choice — consumers match axes positionally, so a property column
// whose axis 0 is pl7.app/sampleId is invisible to them. Widening this split silently breaks
// every downstream block, and the failure surfaces there as "no sequence columns found"
// rather than here.
Test_columnsBySource_onlyAbundanceKeepsTheSampleAxis := func() {
	properties := [{ header: "Target" }]
	split := specs.columnsBySource(["A", "B"], "imgt", properties)

	test.isEqual(1, len(split.perSample), "exactly one per-sample column")
	test.isEqual(
		"pl7.app/vdj/uniqueMoleculeCount",
		split.perSample[0].spec.name,
		"and it is the abundance"
	)

	// Label, one imported property, two main sequences.
	test.isEqual(4, len(split.perRecord), "label + property + two sequences")
	test.isEqual("pl7.app/label", split.perRecord[0].spec.name, "label leads the record columns")

	// Seven regions plus one status, per chain.
	test.isEqual(16, len(split.regions), "eight region columns per chain")
}

// Every column belongs to exactly one bucket, and the three together are allColumns. A column
// that fell out of the split would simply never be emitted, with nothing to report it.
Test_columnsBySource_partitionsAllColumns := func() {
	properties := [{ header: "Target" }]
	chains := ["A", "B"]

	all := specs.allColumns(chains, "kabat", properties)
	split := specs.columnsBySource(chains, "kabat", properties)

	seen := {}
	for bucket in [split.perSample, split.perRecord, split.regions] {
		for col in bucket {
			test.isTrue(seen[col.id] == undefined, "column in two buckets: " + col.id)
			seen[col.id] = true
		}
	}

	test.isEqual(len(all), len(seen), "split covers every column exactly once")
	for col in all {
		test.isTrue(seen[col.id] != undefined, "column missing from the split: " + col.id)
	}
}


// pl7.app/vdj/scClonotypeChain is how consumers recognise a dataset that holds paired chains in
// one frame: clonotype-clustering probes for it, antibody-sequence-liabilities scans for it. A
// one-chain set is bulk-shaped, so stamping it there would make both treat it as paired.
Test_singleChain_carriesNoChainDomain := func() {
	main := specs.mainSequenceColumn("A", false)
	test.isTrue(main.spec.domain["pl7.app/vdj/scClonotypeChain"] == undefined, "main: no chain key")
	test.isTrue(main.spec.domain["pl7.app/vdj/scClonotypeChain/index"] == undefined, "main: no index")
	test.isEqual("VDJRegionInFrame", main.spec.domain["pl7.app/vdj/feature"], "feature survives")
	test.isEqual("aminoacid", main.spec.domain["pl7.app/alphabet"], "alphabet survives")

	region := specs.regionColumnSpec("B", "CDR3", "imgt", false)
	test.isTrue(region.spec.domain["pl7.app/vdj/scClonotypeChain"] == undefined, "region: no chain key")
	test.isTrue(region.spec.domain["pl7.app/vdj/scClonotypeChain/index"] == undefined, "region: no index")
	test.isEqual("imgt", region.spec.domain["pl7.app/vdj/numberingSchema"], "scheme survives")

	status := specs.statusColumnSpec("A", "imgt", false)
	test.isTrue(status.spec.domain["pl7.app/vdj/scClonotypeChain"] == undefined, "status: no chain key")

	// The chain is still named for the reader — it is only the machine-readable claim that goes.
	test.isEqual("Light CDR3 aa", region.spec.annotations["pl7.app/label"], "label keeps the chain")
}

// One mapped chain means bulk-shaped; two means paired. columnsBySource decides it, so the
// process template cannot get it wrong.
Test_columnsBySource_stampsTheChainOnlyWhenPaired := func() {
	oneChain := specs.columnsBySource(["A"], "imgt", [])
	for col in oneChain.perRecord + oneChain.regions {
		test.isTrue(
			col.spec.domain["pl7.app/vdj/scClonotypeChain"] == undefined,
			"one chain must not be stamped: " + col.id
		)
	}

	twoChains := specs.columnsBySource(["A", "B"], "imgt", [])
	stamped := 0
	for col in twoChains.perRecord + twoChains.regions {
		if col.spec.domain["pl7.app/vdj/scClonotypeChain"] != undefined { stamped += 1 }
	}
	// Two main sequences, two statuses, seven regions each.
	test.isEqual(18, stamped, "both chains stamped when paired")
}


// The statistics table carries the chain in each column's domain, not on an axis — the shape the
// block's bulk path already uses. So a one-chain set's statistics are shaped exactly like bulk's.
Test_statsColumns_carryTheChainInTheDomain := func() {
	paired := specs.statsColumns(["A", "B"], "b1")
	test.isEqual(8, len(paired), "four statistics per chain")
	test.isEqual("A_annotated", paired[0].column, "TSV header is chain-prefixed")
	test.isEqual("A", paired[0].spec.domain["pl7.app/vdj/scClonotypeChain"], "chain in the domain")
	test.isEqual("Heavy Annotated", paired[0].spec.annotations["pl7.app/label"], "chain in the label")

	one := specs.statsColumns(["A"], "b1")
	test.isEqual(4, len(one), "four statistics, one chain")
	test.isTrue(
		one[0].spec.domain["pl7.app/vdj/scClonotypeChain"] == undefined,
		"one chain is bulk-shaped: no chain key"
	)
	test.isEqual("Annotated", one[0].spec.annotations["pl7.app/label"], "and no chain in the label")

	// Both chains' columns must be distinct specs or they would dedupe into one.
	test.isTrue(paired[0].spec.domain != paired[4].spec.domain, "chains do not share a domain")
	test.isTrue(paired[0].column != paired[4].column, "chains do not share a TSV column")
}
